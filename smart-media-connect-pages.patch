+type Tab = 'chat' | 'meetings' | 'links' | 'members'
+
+export default function TeamRoomDetailPage() {
+  const { id = '' } = useParams()
+  const { profile } = useAuth()
+  const [room, setRoom] = useState<TeamRoom | null>(null)
+  const [chatId, setChatId] = useState<string | null>(null)
